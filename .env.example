# =============================================================================
# clinic-ai-callbot — example environment
# Copy to .env and adjust. NEVER commit a real .env.
# =============================================================================

# --- Application -----------------------------------------------------------
APP_ENV=development                  # development | staging | production
APP_NAME=clinic-ai-callbot
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=console                   # console | json  (use json in production)

# Secret used for signing/staff auth. MUST be >= 32 chars in production.
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=dev-insecure-secret-change-me-0000000000000000

# --- Database --------------------------------------------------------------
# SQLAlchemy async DSN (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://clinic_app:clinic_app@127.0.0.1:5433/clinic_callbot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# --- Redis (transient conversation session state) --------------------------
# Leave REDIS_URL empty to fall back to the in-process session store.
# The in-process store is single-worker only and is NOT valid for production.
REDIS_URL=redis://127.0.0.1:6380/0
SESSION_TTL_SECONDS=1800

# --- Clinic defaults (development values; real values live in the DB) ------
CLINIC_TIMEZONE=Australia/Melbourne
CLINIC_COUNTRY=AU
EMERGENCY_NUMBER=000
RECEPTION_PHONE=+61390000000

# --- Conversation ----------------------------------------------------------
MAX_MISUNDERSTANDINGS=2              # then escalate to a human
MAX_SLOT_OFFERS=3                    # slots read out per turn (voice-friendly)
AVAILABILITY_SEARCH_DAYS=14          # forward search window
BOOKING_LEAD_MINUTES=60              # minimum notice before an appointment

# --- Silence handling (seconds) — used by the voice pipeline (Milestone 3) -
SILENCE_SHORT_SECONDS=1.2
SILENCE_CHECKIN_SECONDS=4.0
SILENCE_REPROMPT_SECONDS=8.0
SILENCE_TERMINATE_SECONDS=15.0

# --- Privacy ---------------------------------------------------------------
RETAIN_TRANSCRIPTS=false             # store per-turn text in call_events
RETAIN_AUDIO=false                   # never enable without governance sign-off
CALL_DATA_RETENTION_DAYS=90

# --- Security --------------------------------------------------------------
# Comma-separated. Empty = no browser origin allowed (API/CLI clients only).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Staff/admin API keys, comma separated as  key:role  (roles: admin, staff, readonly)
# Development only — production must use a real identity provider.
STAFF_API_KEYS=dev-admin-key:admin,dev-staff-key:staff
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Patient verification (Milestone 5) ------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3

# =============================================================================
# The sections below are placeholders for later milestones. They are read by
# configuration but no provider is wired up yet.
# =============================================================================

# --- Local LLM (Milestone 2) ----------------------------------------------
LLM_PROVIDER=none                    # none | ollama | llamacpp
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b-instruct
LLM_TIMEOUT_SECONDS=6
LLM_MIN_CONFIDENCE=0.6

# --- Speech (Milestone 3) --------------------------------------------------
STT_PROVIDER=none                    # none | faster_whisper | whispercpp
STT_MODEL=small.en
TTS_PROVIDER=none                    # none | piper
TTS_VOICE=en_AU-lessac-medium
VAD_PROVIDER=none                    # none | silero | webrtc

# --- Telephony (Milestone 4) — DO NOT invent real SIP credentials ----------
ASTERISK_ARI_URL=http://127.0.0.1:8088/ari
ASTERISK_ARI_USER=CHANGE_ME
ASTERISK_ARI_PASSWORD=CHANGE_ME
SIP_PROVIDER_HOST=CHANGE_ME
SIP_PROVIDER_USERNAME=CHANGE_ME
SIP_PROVIDER_PASSWORD=CHANGE_ME
