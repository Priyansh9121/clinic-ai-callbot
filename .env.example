# =============================================================================
# clinic-ai-callbot — example environment
# Copy to .env and adjust. NEVER commit a real .env.
# =============================================================================

# --- Application -----------------------------------------------------------
APP_ENV=development                  # development | staging | production
APP_NAME=clinic-ai-callbot
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=console                   # console | json  (use json in production)

# Secret used for signing/staff auth. MUST be >= 32 chars in production.
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=dev-insecure-secret-change-me-0000000000000000

# --- Database --------------------------------------------------------------
# SQLAlchemy async DSN (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://clinic_app:clinic_app@127.0.0.1:5433/clinic_callbot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# --- Redis (transient conversation session state) --------------------------
# Leave REDIS_URL empty to fall back to the in-process session store.
# The in-process store is single-worker only and is NOT valid for production.
REDIS_URL=redis://127.0.0.1:6380/0
SESSION_TTL_SECONDS=1800

# --- Clinic defaults (development values; real values live in the DB) ------
CLINIC_TIMEZONE=Australia/Melbourne
CLINIC_COUNTRY=AU
EMERGENCY_NUMBER=000
RECEPTION_PHONE=+61390000000

# --- Conversation ----------------------------------------------------------
MAX_MISUNDERSTANDINGS=2              # then escalate to a human
MAX_SLOT_OFFERS=3                    # slots read out per turn (voice-friendly)
AVAILABILITY_SEARCH_DAYS=14          # forward search window
BOOKING_LEAD_MINUTES=60              # minimum notice before an appointment

# --- Silence handling (seconds) — used by the voice pipeline (Milestone 3) -
SILENCE_SHORT_SECONDS=1.2
SILENCE_CHECKIN_SECONDS=4.0
SILENCE_REPROMPT_SECONDS=8.0
SILENCE_TERMINATE_SECONDS=15.0

# --- Privacy ---------------------------------------------------------------
RETAIN_TRANSCRIPTS=false             # store per-turn text in call_events
RETAIN_AUDIO=false                   # never enable without governance sign-off
CALL_DATA_RETENTION_DAYS=90

# --- Security --------------------------------------------------------------
# Comma-separated. Empty = no browser origin allowed (API/CLI clients only).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Staff/admin API keys, comma separated as  key:role  (roles: admin, staff, readonly)
# Development only — production must use a real identity provider.
STAFF_API_KEYS=dev-admin-key:admin,dev-staff-key:staff
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Patient verification (Milestone 5) ------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3

# =============================================================================
# The sections below are placeholders for later milestones. They are read by
# configuration but no provider is wired up yet.
# =============================================================================

# --- Local LLM (Milestone 2) ----------------------------------------------
# The model improves *understanding* only. It never performs an action, and
# the deterministic analyser handles every turn on its own if it is absent.
# Leave LLM_PROVIDER=none for exact Milestone 1 behaviour.
LLM_PROVIDER=none                    # none | ollama | llamacpp
LLM_MODE=baseline                    # baseline | llm | shadow
LLM_BASE_URL=http://127.0.0.1:11434
# Required when LLM_PROVIDER is not none. Measured on an Apple M2 / 8 GB over
# the 140-case corpus (deterministic baseline scores 48.8%):
#   qwen2.5:1.5b-instruct        71.2%  ~1.2 s median  0.0% invalid  ← recommended
#   llama3.2:3b-instruct-q4_K_M  76.8%  ~2.0 s median  12.1% invalid
#   qwen2.5:3b-instruct          59.2%  ~2.0 s median   2.1% invalid
# The 1.5b model is recommended for a real-time call agent: two-thirds the
# latency for ~6 points less accuracy, and it never emitted malformed output.
LLM_MODEL=
# A caller is on the line. Slower than this and a slightly less accurate
# deterministic answer is the better product.
LLM_TIMEOUT_SECONDS=3.0
# Below this the model's self-reported confidence is not trusted and the
# deterministic result is used. Small models are poorly calibrated, so treat
# this as a safety valve rather than a probability.
LLM_MIN_CONFIDENCE=0.6
# Bounds simultaneous generations. Saturation falls back rather than queueing.
LLM_MAX_CONCURRENCY=2
LLM_MAX_OUTPUT_TOKENS=200
LLM_TEMPERATURE=0.0
# Consecutive failures before the circuit opens and turns skip the model.
LLM_FAILURE_THRESHOLD=3
LLM_RECOVERY_SECONDS=30
# Skip the model when the deterministic analyser is already certain ("yes",
# "the first one", an explicit request for a human). Pure latency win.
LLM_HYBRID_ROUTING=true

# --- Speech (Milestone 3) --------------------------------------------------
# All default to "none" so the text deployment needs no audio libraries, no
# model weights and no sound card. Set all three to enable voice; a partial
# configuration fails loudly rather than halfway through a call.
#
# Models are NOT in the repository. Fetch them once:
#   Piper voice  -> models/piper/en_GB-alan-medium.onnx (+ .onnx.json)
#                   huggingface.co/rhasspy/piper-voices
#   Silero VAD   -> models/silero/silero_vad.onnx
#   Whisper      -> downloaded automatically into models/whisper on first use
# See docs/architecture/voice-pipeline.md.

STT_PROVIDER=none                    # none | faster_whisper
# base.en measured as the accuracy/latency balance on an M2. tiny.en is ~240 ms
# faster and UNSAFE for this application: it lost a stroke symptom ("numb" ->
# "down") and misread a date of birth. small.en is ~3x slower for no real gain.
STT_MODEL=base.en
STT_LANGUAGE=en
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=1
# Bias decoding toward practitioner and appointment-type names. Clinic
# vocabulary only — the prompt is sent on every utterance, so a patient name
# here would leak across callers.
STT_VOCABULARY_BIAS=true

TTS_PROVIDER=none                    # none | piper
# Piper ships no en_AU voice; en_GB is the closest for an Australian clinic.
# `alan` over `alba` on measured intelligibility — alba is Scottish and said
# "a wee" for "away". Re-check with scripts/benchmark_tts.py.
TTS_VOICE=models/piper/en_GB-alan-medium.onnx
# <1.0 speaks faster. Unset keeps the voice's own pacing.
# TTS_LENGTH_SCALE=1.0
TTS_CACHE_ENTRIES=64

VAD_PROVIDER=none                    # none | silero | energy
VAD_MODEL=models/silero/silero_vad.onnx
VAD_THRESHOLD=0.5

# --- Endpointing -----------------------------------------------------------
# Silence after speech that ends a turn. The measured sweep split no utterance
# at 300 ms either, but real callers pause mid-sentence and being cut off
# halfway through a symptom is worse than 200 ms of latency.
VOICE_END_SILENCE_MS=500
VOICE_INITIAL_SILENCE_MS=6000
VOICE_MIN_SPEECH_MS=200
VOICE_MAX_UTTERANCE_MS=20000

# --- Voice behaviour -------------------------------------------------------
# Budget for the caller's whole silence, measured from when they stop speaking.
# Endpointing and transcription are spent from it first, so this is not "how
# long the engine gets".
VOICE_ACKNOWLEDGEMENT_AFTER_MS=900
VOICE_ACKNOWLEDGEMENT_ENABLED=true
# Consecutive speech frames that count as a real barge-in. Raise it if speaker
# bleed makes the agent interrupt itself (or just use headphones).
VOICE_BARGE_IN_FRAMES=1
# Empty uses the system default device. `voice_chat.py --devices` lists them.
VOICE_INPUT_DEVICE=
VOICE_OUTPUT_DEVICE=

# --- Telephony (Milestone 4) -----------------------------------------------
# Off by default: the text and local-voice deployments need no PBX.
# Local SIP setup: docs/development/local-sip.md
TELEPHONY_ENABLED=false

# Asterisk REST Interface — call control (answer, hangup, transfer).
# Generate the password; do not choose one:  openssl rand -base64 24
# It must match ari.conf. NEVER commit a real value.
ASTERISK_ARI_URL=http://127.0.0.1:8088/ari
ASTERISK_ARI_USER=CHANGE_ME
ASTERISK_ARI_PASSWORD=CHANGE_ME
# Must match the Stasis() argument in the dialplan. A mismatch is silent:
# calls reach Stasis, nothing is listening, and callers get the fallback.
ASTERISK_APP_NAME=clinic-ai

# AudioSocket media server. Asterisk connects TO us.
#
# WARNING: AudioSocket has no authentication of any kind. Anything that can
# reach this port can inject audio into a live call. Keep it on loopback, or on
# a private media network when Asterisk runs on another host. Never public.
#
# TWO ADDRESSES, because they answer different questions:
#
#   TELEPHONY_MEDIA_HOST            where this process binds its listener
#   TELEPHONY_MEDIA_ADVERTISE_HOST  what Asterisk is told to dial
#
# They are the same only when Asterisk runs on this machine. With the PBX in a
# VM or on another host you must bind somewhere reachable and advertise this
# host's address on the PBX network:
#
#   TELEPHONY_MEDIA_HOST=0.0.0.0
#   TELEPHONY_MEDIA_ADVERTISE_HOST=192.168.65.1   # this host, as the VM sees it
#
# Advertising 0.0.0.0 is not a destination, and 127.0.0.1 means the PBX itself
# — the call connects and the caller then hears nothing at all. Leaving the
# advertise host empty with a wildcard bind is refused at start-up.
TELEPHONY_MEDIA_HOST=127.0.0.1
TELEPHONY_MEDIA_ADVERTISE_HOST=
TELEPHONY_MEDIA_PORT=8090
# Wire format: slin (8 kHz, the AudioSocket default) | slin16 (16 kHz, avoids
# resampling entirely) | pcmu | pcma (G.711, for an RTP/ExternalMedia path).
TELEPHONY_WIRE_FORMAT=slin
# soxr quality for 8 <-> 16 kHz. HQ adds ~66 ms of filter delay each way; QQ
# adds ~0.25 ms. Measure with scripts/benchmark_telephony_stt.py before changing.
TELEPHONY_RESAMPLE_QUALITY=HQ

# Transfer. Extensions are validated at load as bare dialplan extensions, and
# the context is transfer-only with no outbound trunk reachable from it, so
# caller speech can never become a dial string.
TELEPHONY_TRANSFER_CONTEXT=clinic-transfer
RECEPTION_EXTENSION=100
VOICEMAIL_EXTENSION=101

# Capacity. The limit is local STT/LLM inference, not the transport.
TELEPHONY_MAX_ACTIVE_CALLS=2
# At capacity: reject (the dialplan's health-check failover sends the caller to
# reception) | transfer_reception. A clinic policy decision — choose it.
TELEPHONY_CAPACITY_POLICY=reject
# Drain before releasing the channel so a goodbye is not clipped.
TELEPHONY_HANGUP_DRAIN_MS=250
# Salt for the caller-number fingerprint. An unsalted hash of a 10-digit number
# is a lookup table, not an anonymisation. Set this per deployment.
TELEPHONY_CALLER_SALT=CHANGE_ME

# --- SIP trunk (Phase B / Milestone 4B) — NOT YET USED ---------------------
# Do NOT invent real SIP credentials or phone numbers. Local SIP must work
# first; see the PSTN readiness section of docs/architecture/telephony.md.
SIP_PROVIDER_HOST=CHANGE_ME
SIP_PROVIDER_USERNAME=CHANGE_ME
SIP_PROVIDER_PASSWORD=CHANGE_ME
