# --- Secrets ---------------------------------------------------------------
.env
.env.*
!.env.example

# --- Local dev data stores (project-local Postgres/Redis clusters) ----------
.devdata/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# --- Node / frontend -------------------------------------------------------
node_modules/
frontend/dist/
*.local

# --- AI model artefacts (never commit weights) -----------------------------
# Anchored to the repository root ON PURPOSE. An unanchored `models/` also
# matches backend/app/database/models/, which silently excluded the entire
# SQLAlchemy ORM layer from git — a fresh clone could not import the app at
# all. Weights live only in ./models (Piper, Whisper, Silero).
/models/
*.gguf
*.onnx
*.bin

# --- Audio (privacy: raw call audio must not land in git) ------------------
*.wav
*.raw
*.opus
recordings/

# --- Asterisk runtime configuration ----------------------------------------
# docs/development/local-sip.md has you copy each *.conf.example to *.conf and
# substitute generated SIP and ARI passwords. Those populated files hold real
# credentials and must never be committed; only the templates are tracked.
# (`*.conf` does not match `*.conf.example`, so the templates stay visible.)
infrastructure/asterisk/*.conf

# --- Editors / OS ----------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
